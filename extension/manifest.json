{
  "manifest_version": 3,
  "name": "Scrollock — a little less feed",
  "version": "1.0.0",
  "description": "Quiet your feeds. Take accountable, five-minute breaks with your friends.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Scrollock" },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
