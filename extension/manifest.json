{
  "manifest_version": 3,
  "name": "Scrollock — a little less feed",
  "version": "1.0.0",
  "description": "Quiet your feeds. Take accountable, five-minute breaks with your friends.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Scrollock" },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
