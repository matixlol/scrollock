# Server only. Copy to .env and populate privately; never commit .env.
NODE_ENV=production
PUBLIC_ORIGIN=https://scrollock.example.com
PORT=8787
HOST=0.0.0.0
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=your_scrollock_bot
# Fixed group for everyone. No extension user can change this destination.
TELEGRAM_GROUP_ID=-1000000000000
ALLOWED_ORIGINS=chrome-extension://replace-with-extension-id,safari-web-extension://replace-with-safari-origin
STORE_PATH=server/data/store.json
