#!/usr/bin/env bash
set -euo pipefail

run_step() {
  local label="$1"
  shift

  printf '\n==> %s\n' "$label"
  time "$@"
}

if ! command -v node >/dev/null 2>&1; then
  echo 'Node.js 22 or newer is required, but node is not installed.' >&2
  exit 1
fi

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if ((node_major < 22)); then
  echo "Node.js 22 or newer is required; found $(node --version)." >&2
  exit 1
fi

run_step "Install locked npm dependencies" npm ci
run_step "Install Playwright Chromium" npx playwright install chromium

printf '\nOrb setup complete (Node %s, npm %s).\n' "$(node --version)" "$(npm --version)"
